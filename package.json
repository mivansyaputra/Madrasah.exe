{
  "name": "fenace-madrasah",
  "version": "1.1.0",
  "description": "Fenace Madrasah - kas LPJ & seragam (offline)",
  "author": "BY. Mbahjimut",
  "main": "main.js",
  "build": {
    "appId": "id.mbahjimut.fenace",
    "productName": "Fenace Madrasah",
    "files": [
      "main.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Fenace-Madrasah-Portable-x64.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  }
}